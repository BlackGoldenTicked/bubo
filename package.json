{
  "name": "bubo",
  "private": true,
  "version": "0.1.17",
  "description": "Asymmetric personal finance tracker: past cashflow, present assets, and future obligations kept as separate layers.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackGoldenTicked/bubo-desktop.git"
  },
  "homepage": "https://github.com/BlackGoldenTicked/bubo-desktop#readme",
  "bugs": {
    "url": "https://github.com/BlackGoldenTicked/bubo-desktop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo -F desktop dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:tauri": "pnpm --filter desktop dev:tauri",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check-architecture": "node scripts/check-architecture.mjs",
    "check-docs": "node scripts/check-docs.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "turbo check-types",
    "test": "vitest run",
    "bubo-cli": "pnpm -F @barrysongdev4real/bubo-cli bubo-cli --",
    "seed:demo": "pnpm -F desktop seed:demo",
    "package": "pnpm -F desktop package",
    "package:app": "pnpm -F desktop package:app",
    "install:local": "node scripts/install-local-app.mjs",
    "release": "node scripts/release.mjs",
    "dist": "pnpm -F desktop dist"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.18",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.12.1"
}
