{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Base capability for the bubo Tauri shell (main window and the menu-bar capture window)",
  "windows": ["main", "quick-capture"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "process:default",
    "updater:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/BlackGoldenTicked/bubo/releases/latest"
        }
      ]
    }
  ]
}
