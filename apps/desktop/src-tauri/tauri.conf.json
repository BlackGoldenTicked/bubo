{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bubo",
  "version": "0.1.17",
  "identifier": "com.chaordex.bubo",
  "build": {
    "beforeDevCommand": "pnpm build:tauri-sidecar && pnpm vite --config vite.config.ts",
    "devUrl": "http://127.0.0.1:54321",
    "beforeBuildCommand": "pnpm build:tauri-sidecar && pnpm build:tauri-renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bubo",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/bubo-sidecar"],
    "resources": {
      "../../../packages/db/migrations/": "migrations",
      "../resources/bubo-demo.sqlite3": "resources/bubo-demo.sqlite3"
    },
    "icon": [
      "icons/icon.ico",
      "../resources/icons/bubo.iconset/icon_32x32.png",
      "../resources/icons/bubo.iconset/icon_128x128.png",
      "../resources/icons/bubo.iconset/icon_256x256.png",
      "../resources/icons/bubo.iconset/icon_512x512.png",
      "../resources/icons/bubo.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCREI1OEZGRDNCODIyOUEKUldTYUlyalQvMWpieTNQakx5ZG04d05qcmJTVU41Q2FSWlFIVjUwdG42NDYzdWxhM3JQRnE4aFcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
